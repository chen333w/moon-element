///|
/// Tag-name validation and skeleton generation. Pure string logic, kept in core so it is
/// testable on every backend; the CLI only prints the result.

///|
/// Validate a custom element name against the HTML specification.
///
/// Rules:
/// - non-empty, and must contain a hyphen (`mywidget` is not a valid name, `my-widget` is)
/// - must not start or end with a hyphen
/// - lowercase ASCII letters, digits, hyphen, dot and underscore only (uppercase is invalid)
/// - must not start with `xml` (case-insensitive, reserved by the spec)
/// - must not be a reserved name (`annotation-xml`, `color-profile`, `font-face`, ...)
///
/// Only an ASCII subset is accepted (the spec allows some non-ASCII), and uppercase is rejected.
pub fn validate_tag_name(tag : String) -> Bool {
  let n = tag.char_length()
  if n == 0 {
    return false
  }
  // must contain a hyphen
  let mut has_hyphen = false
  let mut i = 0
  while i < n {
    match tag.get_char(i) {
      Some(c) => if c == '-' { has_hyphen = true }
      None => ()
    }
    i = i + 1
  }
  if !has_hyphen {
    return false
  }
  // must not start or end with a hyphen
  let first = tag.get_char(0).unwrap_or(' ')
  let last = tag.get_char(n - 1).unwrap_or(' ')
  if first == '-' || last == '-' {
    return false
  }
  // character set
  i = 0
  while i < n {
    match tag.get_char(i) {
      Some(c) => if !is_tag_char(c) { return false }
      None => ()
    }
    i = i + 1
  }
  // reserved prefix and reserved names
  if has_prefix_ignoring_case(tag, "xml") {
    return false
  }
  for
    reserved in [
      "annotation-xml", "color-profile", "font-face", "font-face-src", "font-face-uri",
      "font-face-format", "font-face-name", "missing-glyph",
    ] {
    if tag == reserved {
      return false
    }
  }
  true
}

///|
fn is_tag_char(c : Char) -> Bool {
  let v = c.to_int()
  let lower_a = 'a'.to_int()
  let lower_z = 'z'.to_int()
  let digit_0 = '0'.to_int()
  let digit_9 = '9'.to_int()
  (v >= lower_a && v <= lower_z) ||
  (v >= digit_0 && v <= digit_9) ||
  v == '-'.to_int() ||
  v == '.'.to_int() ||
  v == '_'.to_int()
}

///|
fn has_prefix_ignoring_case(s : String, prefix : String) -> Bool {
  if s.char_length() < prefix.char_length() {
    return false
  }
  let mut i = 0
  while i < prefix.char_length() {
    let a = ascii_lower(s.get_char(i).unwrap_or(' '))
    let b = ascii_lower(prefix.get_char(i).unwrap_or(' '))
    if a != b {
      return false
    }
    i = i + 1
  }
  true
}

///|
fn ascii_lower(c : Char) -> Char {
  let v = c.to_int()
  if v >= 'A'.to_int() && v <= 'Z'.to_int() {
    match (v + 32).to_char() {
      Some(l) => l
      None => c
    }
  } else {
    c
  }
}

///|
/// `my-widget` → `my_widget` (for generated identifiers)
pub fn tag_to_snake(tag : String) -> String {
  let out : Array[Char] = []
  let n = tag.char_length()
  let mut i = 0
  while i < n {
    let c = tag.get_char(i).unwrap_or(' ')
    if c == '-' || c == '.' {
      out.push('_')
    } else {
      out.push(c)
    }
    i = i + 1
  }
  String::from_iter(out.iter())
}

///|
pub fn component_skeleton(
  tag : String,
  mode~ : RenderMode = ShadowDom,
) -> String? {
  if !validate_tag_name(tag) {
    return None
  }
  let snake = tag_to_snake(tag)
  // CSS constant name: my-widget → MY_WIDGET_CSS (const requires an uppercase identifier)
  let css_name = snake.to_upper() + "_CSS"
  let mode_name = mode.name()
  let is_light = match mode {
    LightDom => true
    ShadowDom => false
  }
  // Line by line rather than a `#|` literal: `#|` is raw text and does not interpolate `\{...}`.
  let lines : Array[String] = [
    "// Custom element skeleton generated by the moon-element CLI: \{tag} (render mode: \{mode_name})",
    "//",
    "// Usage:",
    "// 1) Declare the dependencies in this package's moon.pkg (imports belong to package config):",
    "//      import {",
    "//        \"chen333w/moon-element/core\" @core,",
    "//        \"chen333w/moon-element/dom\" @dom,",
    "//      }",
    "// 2) Put this file in the package and call register_\{snake}() at the entry point",
    "// 3) The result is a standard custom element: write <\{tag}> in the host page",
  ]
  if is_light {
    lines.push(
      "//    light mode: no shadow root, content renders into the element itself;",
    )
    lines.push(
      "//    the CSS below is scoped to `\{tag}` by core.scope_css and does not leak to the page",
    )
  } else {
    lines.push(
      "//    shadow mode: content renders into a shadow root page styles cannot reach; `:host` works",
    )
  }
  lines.push("")
  lines.push("///|")
  lines.push("const \{css_name} : String =")
  lines.push("  #|:host { display: block; }")
  lines.push("  #|.label { color: #3b4453; }")
  lines.push("")
  lines.push("///|")
  lines.push("fn render_\{snake}(props : @core.Props) -> @core.View {")
  lines.push("  let label = props.get_string(\"label\").unwrap_or(\"\")")
  // Keep on one line: `moon fmt` merges multi-line calls, which would break the CI drift check
  lines.push(
    "  @core.View::element(\"span\", [(\"class\", \"label\")], [@core.View::text(label)])",
  )
  lines.push("}")
  lines.push("")
  lines.push("///|")
  lines.push("pub fn register_\{snake}() -> Unit {")
  lines.push("  @dom.define_component(")
  lines.push("    \"\{tag}\",")
  lines.push("    [@core.AttrSpec::string(\"label\", \"\")],")
  lines.push("    render_\{snake},")
  lines.push("    styles=\{css_name},")
  if is_light {
    lines.push("    mode=@core.LightDom,")
  }
  lines.push("    events=[")
  lines.push(
    "      // events the host page should receive use crossing (bubbles + composed)",
  )
  lines.push("      @core.EventSpec::crossing(\"\{tag}-changed\"),")
  lines.push("    ],")
  lines.push("  )")
  lines.push("}")
  // Join with \n and no trailing newline: callers print the result, so the file ends with
  // exactly one newline, matching moon fmt's normalization.
  let mut out = ""
  let mut li = 0
  while li < lines.length() {
    if li > 0 {
      out = out + "\n"
    }
    out = out + lines[li]
    li = li + 1
  }
  Some(out)
}

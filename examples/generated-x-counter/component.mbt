// Custom element skeleton generated by the moon-element CLI: x-counter (render mode: shadow)
//
// Usage:
// 1) Declare the dependencies in this package's moon.pkg (imports belong to package config):
//      import {
//        "chen333w/moon-element/core" @core,
//        "chen333w/moon-element/dom" @dom,
//      }
// 2) Put this file in the package and call register_x_counter() at the entry point
// 3) The result is a standard custom element: write <x-counter> in the host page
//    shadow mode: content renders into a shadow root page styles cannot reach; `:host` works

///|
const X_COUNTER_CSS : String =
  #|:host { display: block; }
  #|.label { color: #3b4453; }

///|
fn render_x_counter(props : @core.Props) -> @core.View {
  let label = props.get_string("label").unwrap_or("")
  @core.View::element("span", [("class", "label")], [@core.View::text(label)])
}

///|
pub fn register_x_counter() -> Unit {
  @dom.define_component(
    "x-counter",
    [@core.AttrSpec::string("label", "")],
    render_x_counter,
    styles=X_COUNTER_CSS,
    events=[
      // events the host page should receive use crossing (bubbles + composed)
      @core.EventSpec::crossing("x-counter-changed"),
    ],
  )
}

supported_targets = "js"

import {
  "chen333w/moon-element/core",
  "chen333w/moon-element/dom",
}

pkgtype(kind: "executable")

// Note: this file deliberately omits `options(link: { "js": { "format": "esm" } })`.
// The option makes no difference to an executable package's artifact (no exports, no
// requires — a plain script), and keeping it would suggest that it does something.
// See examples/demo/README.md.

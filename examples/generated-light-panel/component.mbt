// Generated by `moon run cmd/main -- x-light-panel` (render mode: light).
// Dependencies for moon.pkg: "chen333w/moon-element/core" @core, "chen333w/moon-element/dom" @dom.
// Call register_x_light_panel() and write <x-light-panel> in the page.
// Light mode: no shadow root, so the CSS below is scoped to `x-light-panel` by core.scope_css.

///|
const X_LIGHT_PANEL_CSS : String =
  #|:host { display: block; }
  #|.label { color: #3b4453; }

///|
fn render_x_light_panel(props : @core.Props) -> @core.View {
  let label = props.get_string("label").unwrap_or("")
  @core.View::element("span", [("class", "label")], [@core.View::text(label)])
}

///|
pub fn register_x_light_panel() -> Unit {
  @dom.define_component(
    "x-light-panel",
    [@core.AttrSpec::string("label", "")],
    render_x_light_panel,
    styles=X_LIGHT_PANEL_CSS,
    mode=@core.LightDom,
    events=[
      // events the host page should receive use crossing (bubbles + composed)
      @core.EventSpec::crossing("x-light-panel-changed"),
    ],
  )
}

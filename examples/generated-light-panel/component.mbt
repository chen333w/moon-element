// Custom element skeleton generated by the moon-element CLI: x-light-panel (render mode: light)
//
// Usage:
// 1) Declare the dependencies in this package's moon.pkg (imports belong to package config):
//      import {
//        "chen333w/moon-element/core" @core,
//        "chen333w/moon-element/dom" @dom,
//      }
// 2) Put this file in the package and call register_x_light_panel() at the entry point
// 3) The result is a standard custom element: write <x-light-panel> in the host page
//    light mode: no shadow root, content renders into the element itself;
//    the CSS below is scoped to `x-light-panel` by core.scope_css and does not leak to the page

///|
const X_LIGHT_PANEL_CSS : String =
  #|:host { display: block; }
  #|.label { color: #3b4453; }

///|
fn render_x_light_panel(props : @core.Props) -> @core.View {
  let label = props.get_string("label").unwrap_or("")
  @core.View::element("span", [("class", "label")], [@core.View::text(label)])
}

///|
pub fn register_x_light_panel() -> Unit {
  @dom.define_component(
    "x-light-panel",
    [@core.AttrSpec::string("label", "")],
    render_x_light_panel,
    styles=X_LIGHT_PANEL_CSS,
    mode=@core.LightDom,
    events=[
      // events the host page should receive use crossing (bubbles + composed)
      @core.EventSpec::crossing("x-light-panel-changed"),
    ],
  )
}
